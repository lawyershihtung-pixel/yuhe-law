rules_version = '2';

// 禹河法律事務所 — Firestore 安全規則
//
// 部署方式（擇一）:
//   A. Firebase 主控台 → Firestore Database → 規則(Rules)分頁,
//      把整段貼上後按「發布(Publish)」。
//   B. 使用 Firebase CLI: `firebase deploy --only firestore:rules`
//
// 核心原則:
//   - news(前台新聞): 任何人都可讀,只有「已登入的管理員」可以新增/修改/刪除。
//   - 其他所有集合: 一律禁止,避免資料庫其他部分被公開存取。
service cloud.firestore {
  match /databases/{database}/documents {

    // 前台新聞:
    //   - 已發布(published==true)的文章任何人可讀
    //   - 未發布的草稿只有登入的管理員可讀(外部 API 也讀不到)
    //   - 只有登入的管理員可新增/修改/刪除
    // 注意:兩條 read 規則要「分開寫」。若把 published 與 auth 併成
    //       `published==true || auth != null` 同一式,Firestore 對未登入
    //       的列表查詢會保守地整條拒絕,導致前台讀取失敗。
    match /news/{docId} {
      allow read:  if resource.data.published == true;  // 已發布:任何人可讀
      allow read:  if request.auth != null;             // 登入的管理員:可讀全部(含草稿)
      allow write: if request.auth != null;
    }

    // 前台法律知識:規則與 news 相同(已發布公開、草稿僅管理員、僅管理員可寫)
    match /knowledge/{docId} {
      allow read:  if resource.data.published == true;
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // 預設拒絕其餘所有存取
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
